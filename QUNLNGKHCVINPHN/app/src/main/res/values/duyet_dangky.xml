<?xml version="1.0" encoding="utf-8"?>
<resources>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duyệt phiếu đăng ký"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <ListView
            android:id="@+id/lvPhieuDK"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button android:id="@+id/btnDongY" android:text="Đồng ý" android:layout_weight="1"/>
            <Button android:id="@+id/btnTuChoi" android:text="Từ chối" android:layout_weight="1"/>
        </LinearLayout>

    </LinearLayout>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý học phần"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="15dp"/>

        <EditText android:id="@+id/edtMaHP" android:hint="Mã học phần"/>
        <EditText android:id="@+id/edtTenHP" android:hint="Tên học phần"/>
        <EditText android:id="@+id/edtTinChi" android:hint="Số tín chỉ" android:inputType="number"/>
        <EditText android:id="@+id/edtNganh" android:hint="Ngành"/>
        <EditText android:id="@+id/edtHocKy" android:hint="Học kỳ" android:inputType="number"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button android:id="@+id/btnThemHP" android:text="Thêm" android:layout_weight="1"/>
            <Button android:id="@+id/btnSuaHP" android:text="Sửa" android:layout_weight="1"/>
            <Button android:id="@+id/btnXoaHP" android:text="Xóa" android:layout_weight="1"/>
        </LinearLayout>

    </LinearLayout>
</resources>